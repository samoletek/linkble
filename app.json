{
  "expo": {
    "name": "Linkble",
    "slug": "linkble",
    "version": "1.0.7",
    "icon": "./assets/logo/logo-original.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000814",
      "dark": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#000814"
      }
    },
    "plugins": [
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.12.0"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false
          }
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "development",
          "smallIcons": [
            "./assets/images/adaptive_icon.png"
          ]
        }
      ],
      "expo-splash-screen"
    ],
    "android": {
      "package": "io.architeq.linkble",
      "versionCode": 10,
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "io.architeq.linkble",
      "buildNumber": "10",
      "usesAppleSignIn": true,
      "appleTeamId": "9WXK66PLY2",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.394574785122-vr753lk111iv5uh6pm9ltsoen01tgv38"
            ]
          }
        ]
      }
    },
    "extra": {
      "eas": {
        "projectId": "61f38d60-7cc5-45ac-8a82-f587b95f9a0e"
      }
    }
  }
}